# 复制成 .env 再改：cp .env.example .env（deploy.sh 第一次运行会自动复制）
# 镜像里只有代码，下面所有模型相关的路径和地址都在运行时生效，改完 ./deploy.sh 重新部署即可，不用重新构建。

# ---------- 标注服务 ----------
# 网页端口
LABEL_PORT=8088
# 数据目录（项目、图片、标注、大模型配置），宿主机路径
LABEL_DATA_DIR=./data
# 可导入的数据集目录，容器中用 /data/migrate 访问（兼容旧 /imports）；只读挂载
# 服务器建议设为 /data/migrate，这样网页填写路径与服务器一致
LABEL_IMPORT_DIR=./imports
# 分割模型权重目录，宿主机路径，挂到容器 /models；留空 = 数据目录/models
LABEL_MODELS_DIR=
# 权重目录里的 SAM3 权重文件名（GPU 版用）
SAM3_WEIGHTS=sam3.pt
# 权重目录里 SAM（CPU）的 ONNX 子目录，里面放 encoder.onnx 和 decoder.onnx
SAM1_WEIGHTS_DIR=sam1
# SAM3：auto（GPU 版开、CPU 版关）| on | off
SAM3=auto
# 图像特征缓存闲置释放秒数（0 禁用），模型权重保持常驻
SAM_CACHE_IDLE_SECONDS=120
# 限制 Linux 分配器的线程内存池，减少连续推理后的内存滞留
LABEL_MALLOC_ARENA_MAX=2
# 容器内用哪个用户写文件，deploy.sh 会自动填成当前用户，避免数据目录里出现 root 文件
LABEL_UID=
LABEL_GID=

# ---------- 大模型接口（两个版本都可用）----------
# 第一次启动时写进「大模型设置」的默认接口，之后以网页里的设置为准。
# 接外部 OpenAI 兼容服务（vLLM、Ollama、云端 API）就填这里；GPU 版用自带大模型时留空，会自动指向 vlm 容器。
VLM_URL=
VLM_URL_MODEL=
VLM_API_KEY=
# 发给大模型的图片长边，越大越清楚、越慢
VLM_IMAGE_SIDE=512

# ---------- GPU 版 ----------
# 标注服务（SAM3）用第几块卡
WEB_GPU=0
# 本地多模态大模型（llama.cpp）。不填 VLM_MODEL 就不启动大模型容器。
# 模型所在的宿主机目录，和目录里的文件名
VLM_MODEL_DIR=
VLM_MODEL=
VLM_MMPROJ=
# 可选的 LoRA（gguf），所在宿主机目录和文件名
VLM_LORA_DIR=
VLM_LORA=
# 接口里的模型名
VLM_ALIAS=local-vlm
# 大模型用第几块卡
VLM_GPU=0
# 上下文长度、并发数、放到 GPU 的层数
VLM_CTX=4096
VLM_PARALLEL=1
VLM_NGL=99
# 额外的 llama-server 参数，例如：--flash-attn on
VLM_EXTRA_ARGS=
# 编译 llama-server 的显卡架构：75 图灵(20系/T4) 80 A100 86 安培(30系) 89 Ada(40系) 90 H100；只填自己的卡编译更快
CUDA_ARCHS=75;80;86;89;90

# ---------- 构建镜像（国内网络按需打开）----------
# GPU 版要的 SAM3、llama.cpp 源码只在第一次由 scripts/fetch-vendor.sh 下载到 vendor/，之后构建都用本地的。
# 下载时走 BUILD_PROXY；也可以用 GitHub 加速前缀：
# GITHUB_PREFIX=https://ghfast.top/
# 构建时用的代理；代理只监听 127.0.0.1 时同时设 BUILD_NETWORK=host
# BUILD_PROXY=http://127.0.0.1:7897
# BUILD_NETWORK=host
# 直连更快的站点不走代理，逗号分隔
# BUILD_NO_PROXY=download.pytorch.org,download-r2.pytorch.org,mirrors.ustc.edu.cn
# PIP_INDEX=https://mirrors.ustc.edu.cn/pypi/simple
# APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
# TORCH_INDEX_GPU=https://download.pytorch.org/whl/cu124
# 编译 llama-server 用的 NVIDIA CUDA apt 源（国内 CDN）
# CUDA_APT_REPO=https://developer.download.nvidia.cn/compute/cuda/repos/debian12/x86_64
